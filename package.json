{
  "name": "electron-converge",
  "version": "1.0.0",
  "description": "Strongly consistent state across Electron processes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markbakos/electron-converge.git"
  },
  "bugs": "https://github.com/markbakos/electron-converge/issues",
  "homepage": "https://github.com/markbakos/electron-converge#readme",
  "keywords": [
    "electron",
    "state-management",
    "react",
    "ipc"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./main": {
      "types": "./dist/electron-main/index.d.ts",
      "import": "./dist/electron-main/index.js"
    },
    "./renderer": {
      "types": "./dist/electron-renderer/index.d.ts",
      "import": "./dist/electron-renderer/index.js"
    },
    "./preload": {
      "types": "./dist/electron-preload/index.d.ts",
      "import": "./dist/electron-preload/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.18.1",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "pnpm clean && tsc",
    "build:fixture": "node scripts/build-electron-fixture.mjs",
    "bench": "pnpm build && pnpm build:fixture && node bench/electron.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "pnpm build && pnpm build:fixture && node --test test/*.test.mjs test/protocol/*.test.mjs && tsc -p tsconfig.test.json",
    "test:e2e": "pnpm build && pnpm build:fixture && node --test test/electron-e2e.test.mjs",
    "test:pack": "pnpm build && node scripts/verify-package.mjs",
    "check": "pnpm test",
    "prepublishOnly": "pnpm check && node scripts/verify-package.mjs"
  },
  "peerDependencies": {
    "electron": ">=42 <45",
    "react": ">=18 <20"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/use-sync-external-store": "1.5.0",
    "electron": "42.10.1",
    "esbuild": "0.28.2",
    "fast-check": "4.9.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "use-sync-external-store": "1.6.0"
  }
}
