{
  "name": "electron-converge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.18.1",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "tsc",
    "clean": "tsc -b --clean",
    "test": "pnpm build && node --test test/*.test.mjs test/protocol/*.test.mjs && tsc -p tsconfig.test.json",
    "check": "pnpm test"
  },
  "devDependencies": {
    "fast-check": "4.9.0",
    "typescript": "7.0.2"
  }
}
