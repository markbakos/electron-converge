{
  "name": "electron-converge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./main": {
      "types": "./dist/electron-main/index.d.ts",
      "import": "./dist/electron-main/index.js"
    },
    "./renderer": {
      "types": "./dist/electron-renderer/index.d.ts",
      "import": "./dist/electron-renderer/index.js"
    }
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.18.1",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "tsc",
    "clean": "tsc -b --clean",
    "test": "pnpm build && node --test test/*.test.mjs test/protocol/*.test.mjs && tsc -p tsconfig.test.json",
    "check": "pnpm test"
  },
  "peerDependencies": {
    "electron": ">=42 <45"
  },
  "devDependencies": {
    "electron": "42.10.1",
    "fast-check": "4.9.0",
    "typescript": "7.0.2"
  }
}
